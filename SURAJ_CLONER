class SurajUltimate:
    def __init__(self):
        self.ids = []
        self.ok = 0; self.cp = 0; self.loop = 0

    def menu(self):
        banner()
        print(f"{G} [1] {A}India Random Clone (Super Fast)")
        print(f"{G} [2] {A}Pakistan Random Clone")
        print(f"{G} [3] {A}File Cloning (Pro Name Passwords)")
