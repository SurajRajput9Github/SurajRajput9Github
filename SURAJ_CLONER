def auto_update():
    # यहाँ अपनी GitHub Raw फाइल का लिंक डालें जहाँ आप नया कोड रखेंगे
    github_link = "https://githubusercontent.com"
    try:
        current_code = open(__file__, 'r').read()
        latest_code = requests.get(github_link).text
        if latest_code != current_code and "SurajUltimate" in latest_code:
            print(f"{G} [!] New Update Found! Updating Tool...")
            with open(__file__, 'w') as f:
                f.write(latest_code)
            print(f"{G} [!] Update Complete. Restarting..."); time.sleep(2)
            os.execl(sys.executable, sys.executable, *sys.argv)
    except:
        pass

